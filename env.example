# ---------------------------------------------------------------------------
# Enterprise Knowledge Assistant - Environment Configuration
# Copy this file to `.env` and fill in the values you need.
# You only need to set the API key for the provider(s) you plan to use.
# ---------------------------------------------------------------------------

# --- LLM Provider API Keys ---
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Default provider/backend selected on first app load ---
# (users can still switch between them from the Streamlit sidebar)
DEFAULT_LLM_PROVIDER=openai        # openai | gemini
DEFAULT_VECTOR_STORE=faiss         # faiss | chroma

# --- Model names ---
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# --- LLM generation settings ---
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# --- Embeddings (local, free, no API key required) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Reranker (local, free, no API key required) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
VECTOR_TOP_K=10
BM25_TOP_K=10
HYBRID_ALPHA=0.5
RERANK_CANDIDATE_K=10
FINAL_TOP_K=4

# --- Memory ---
MEMORY_MAX_TURNS=6

# --- ChromaDB ---
CHROMA_COLLECTION=employee_knowledge_base
